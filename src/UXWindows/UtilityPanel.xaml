<Window x:Class="UXWindows.UtilityPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UX-windows"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}">
    <Border Background="Transparent">
        <!-- Barre de défilement cachée : la molette suffit si tout ne tient pas en hauteur. -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
        <StackPanel Margin="20,28">

            <!-- Chaque carte se déplace à la souris : maintenir le clic et glisser vers le haut ou le bas. -->
            <StackPanel x:Name="Widgets">
            <Border x:Name="ClockCard" Tag="clock" Style="{StaticResource WidgetCard}">
                <StackPanel>
                    <TextBlock x:Name="TimeText" Text="00:00" FontSize="72" FontWeight="Light"/>
                    <TextBlock x:Name="DateText" Text="samedi 7 novembre" FontSize="20" Margin="4,0,0,0"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Border>
            <Border x:Name="CpuCard" Tag="cpu" Style="{StaticResource WidgetCard}">
                <StackPanel>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Processeur" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="CpuName" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,1,0,0"/>
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CpuTemp" Grid.Column="0" Text="–" FontSize="28" FontWeight="Light"/>
                            <TextBlock x:Name="CpuPower" Grid.Column="1" Text="–" FontSize="28" FontWeight="Light"/>
                            <TextBlock x:Name="CpuLoadText" Grid.Column="2" Text="–" FontSize="28" FontWeight="Light"/>
                        </Grid>
                        <ProgressBar x:Name="CpuLoadBar" Height="3" Margin="0,10,0,0" Maximum="100"
                                     Background="{StaticResource BarTrack}" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                        <TextBlock x:Name="CpuHint" Visibility="Collapsed" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Accent}" Cursor="Hand" MouseLeftButtonUp="CpuHint_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="GpuCard" Tag="gpu" Style="{StaticResource WidgetCard}">
                <StackPanel>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Carte graphique" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="GpuName" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,1,0,0"/>
                        </DockPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GpuTemp" Grid.Column="0" Text="–" FontSize="28" FontWeight="Light"/>
                            <TextBlock x:Name="GpuPower" Grid.Column="1" Text="–" FontSize="28" FontWeight="Light"/>
                            <TextBlock x:Name="GpuLoadText" Grid.Column="2" Text="–" FontSize="28" FontWeight="Light"/>
                        </Grid>
                        <ProgressBar x:Name="GpuLoadBar" Height="3" Margin="0,10,0,0" Maximum="100"
                                     Background="{StaticResource BarTrack}" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="FansCard" Tag="fans" Style="{StaticResource WidgetCard}">
                <StackPanel>
                    <TextBlock Text="Ventilateurs · EZFAN" Style="{StaticResource CardLabel}"/>
                    <StackPanel>
                        <ItemsControl x:Name="FanProfiles" Margin="-4,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FlatButton}" Content="{Binding Name}" Tag="{Binding Name}"
                                            Background="{Binding Background}" Foreground="{Binding Foreground}"
                                            FontSize="12" Padding="10,4" Margin="4,0,0,6" Click="FanProfile_Click"
                                            ToolTip="Profil EZFAN"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FanSafety" Visibility="Collapsed" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Accent}"
                                   Text="Température critique : EZFAN met tous les ventilateurs à fond."/>
                        <ItemsControl x:Name="FanList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10" ToolTip="{Binding Reason}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0"/>
                                        </DockPanel>
                                        <ProgressBar Height="3" Margin="0,5,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     Background="{StaticResource BarTrack}" Foreground="{StaticResource Ok}"
                                                     BorderThickness="0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FanIdle" Text="EZFAN n'est pas lancé" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="FanWarning" Visibility="Collapsed" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Accent}"/>
                        <Button Style="{StaticResource FlatButton}" Background="{StaticResource CardHover}" Padding="0,8"
                                Click="OpenEzfan_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="OpenEzfanText" Text="Ouvrir EZFAN" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="MusicCard" Tag="music" Style="{StaticResource WidgetCard}">
                <StackPanel>
                    <TextBlock Text="Musique" Style="{StaticResource CardLabel}"/>
                    <Grid>
                        <TextBlock x:Name="MusicIdle" Text="Rien en lecture" FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <DockPanel x:Name="MusicPanel" Visibility="Collapsed">
                            <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="6" Background="{StaticResource BarTrack}"
                                    ClipToBounds="True" Margin="0,0,14,0">
                                <Image x:Name="Artwork" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TrackArtist" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="-8,4,0,0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Précédent" Click="Previous_Click"/>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                            ToolTip="Lecture / pause" Click="PlayPause_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Suivant" Click="Next_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="ClaudeCard" Tag="claude" Style="{StaticResource WidgetCard}">
                <StackPanel>
                    <TextBlock Text="Claude Code" Style="{StaticResource CardLabel}"/>
                    <StackPanel>
                        <ItemsControl x:Name="ClaudeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Project}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ClaudeIdle" Text="Aucune session récente" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <Button Style="{StaticResource FlatButton}" Background="{StaticResource CardHover}" Padding="0,8"
                                Click="LaunchClaude_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ouvrir Claude" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
