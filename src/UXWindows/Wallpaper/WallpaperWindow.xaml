<Window x:Class="UXWindows.Wallpaper.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UX-windows fond"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Black">
    <Grid>
        <Image x:Name="Picture" Stretch="UniformToFill" Visibility="Collapsed"/>
        <MediaElement x:Name="Video"
                      Stretch="UniformToFill"
                      IsMuted="True"
                      Volume="0"
                      Visibility="Collapsed"/>
    </Grid>
</Window>
