<Window x:Class="UXWindows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réglages UX-windows"
        Width="560" SizeToContent="Height" MaxHeight="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF16161B"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="26,-6,0,10"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,8,28,28">

            <!-- ===== Fonds d'écran ===== -->
            <TextBlock Text="Fonds d'écran" Style="{StaticResource SectionTitle}" Margin="4,20,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel x:Name="WallpaperRows"/>
                    <DockPanel Margin="0,6,0,0">
                        <ComboBox x:Name="FpsBox" DockPanel.Dock="Right" Width="110" SelectionChanged="Fps_Changed">
                            <ComboBoxItem Content="15 images/s" Tag="15"/>
                            <ComboBoxItem Content="30 images/s" Tag="30"/>
                            <ComboBoxItem Content="60 images/s" Tag="60"/>
                        </ComboBox>
                        <TextBlock Text="Fluidité des vidéos (moins = plus économe)" Style="{StaticResource Label}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Panneau ===== -->
            <TextBlock Text="Panneau" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <ComboBox x:Name="StyleBox" DockPanel.Dock="Right" Width="200" SelectionChanged="Style_Changed">
                            <ComboBoxItem Content="Liquid glass" Tag="liquid"/>
                            <ComboBoxItem Content="Classique (sobre)" Tag="classic"/>
                        </ComboBox>
                        <TextBlock Text="Style des cartes" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <CheckBox x:Name="BlurBox" Content="Flouter le fond derrière les cartes (Liquid glass)" Click="Style_Changed"
                              Margin="0,0,0,14"/>
                    <DockPanel Margin="0,0,0,14">
                        <ComboBox x:Name="ScreenBox" DockPanel.Dock="Right" Width="200" SelectionChanged="Screen_Changed"/>
                        <TextBlock Text="Écran du panneau" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <CheckBox x:Name="ShowSystemBox" Content="Système (processeur et carte graphique)" Click="Sections_Changed"/>
                    <CheckBox x:Name="ShowMusicBox" Content="Musique" Click="Sections_Changed"/>
                    <CheckBox x:Name="ShowClaudeBox" Content="Claude Code" Click="Sections_Changed"/>
                    <CheckBox x:Name="ShowFansBox" Content="Ventilateurs (avec l'app EZFAN)" Click="Sections_Changed" Margin="0"/>
                    <DockPanel Margin="0,14,0,0">
                        <ComboBox x:Name="GpuBox" DockPanel.Dock="Right" Width="200" SelectionChanged="Gpu_Changed"/>
                        <TextBlock Text="Carte graphique affichée" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Button Content="Ordre d'origine" Style="{StaticResource SmallButton}" DockPanel.Dock="Right"
                                Click="ResetCards_Click"/>
                        <TextBlock Text="Pour déplacer une carte du panneau, maintiens le clic dessus et fais-la glisser."
                                   Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== Démarrage ===== -->
            <TextBlock Text="Démarrage" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="StartupBox" Content="Lancer UX-windows avec Windows" Click="Startup_Changed"/>
                    <CheckBox x:Name="CpuBox" Content="Température et watts du processeur" Click="Cpu_Changed"/>
                    <TextBlock x:Name="CpuHint" Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="4,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
