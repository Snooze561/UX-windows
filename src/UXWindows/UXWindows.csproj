<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UXWindows</AssemblyName>
    <RootNamespace>UXWindows</RootNamespace>
    <Product>UX-windows</Product>
    <Version>0.7.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF et Windows Forms ont des noms en commun (Brush, Image…) : on n'importe pas Windows Forms partout. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UXWindows.Video\UXWindows.Video.csproj" />
    <ProjectReference Include="..\UXWindows.Core\UXWindows.Core.csproj" />
  </ItemGroup>

</Project>
